FILE_NAME = "bookings.txt"
GST_RATE = 12

# Room details stored in a dictionary
rooms = {
    101: {"type": "Single", "rate": 2000},
    102: {"type": "Double", "rate": 3500},
    201: {"type": "Suite", "rate": 6000},
}

# Current bookings stored as a list of dictionaries
bookings = []


def save_bookings():
    with open(FILE_NAME, "w") as f:
        for b in bookings:
            f.write("Room " + str(b["room"]) + " - " + b["guest"] + " - " + str(b["nights"]) + " nights\n")


def load_bookings():
    try:
        with open(FILE_NAME, "r") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                parts = line.split(" - ")
                if len(parts) < 3:
                    continue
                room = int(parts[0].replace("Room", "").strip())
                nights = int(parts[-1].split()[0])
                guest = " - ".join(parts[1:-1])
                bookings.append({"room": room, "guest": guest, "nights": nights})
    except FileNotFoundError:
        pass
    except ValueError:
        print("Warning: bookings.txt has invalid data and was partly ignored.")


def is_booked(room):
    for b in bookings:
        if b["room"] == room:
            return True
    return False


def view_available():
    available = []
    for room, info in rooms.items():
        if not is_booked(room):
            available.append(str(room) + " " + info["type"] + " Rs. " + str(info["rate"]))
    if available:
        print(" | ".join(available))
    else:
        print("No rooms available.")


def calculate_bill(room, nights):
    base = rooms[room]["rate"] * nights
    gst = base * GST_RATE // 100
    return base, gst, base + gst


def book_room():
    guest = input("Guest name: ").strip()
    if guest == "":
        print("Guest name cannot be empty.")
        return
    try:
        room = int(input("Room number: "))
    except ValueError:
        print("Invalid room number.")
        return
    if room not in rooms:
        print("Invalid room number.")
        return
    if is_booked(room):
        print("Room " + str(room) + " is already booked. Please choose another room.")
        return
    try:
        nights = int(input("Nights: "))
    except ValueError:
        print("Invalid number of nights.")
        return
    if nights < 1 or nights > 30:
        print("Nights must be between 1 and 30.")
        return

    bookings.append({"room": room, "guest": guest, "nights": nights})
    save_bookings()
    base, gst, total = calculate_bill(room, nights)
    unit = "night" if nights == 1 else "nights"
    print("Room " + str(room) + " booked for " + guest + " | " + str(nights) + " " + unit)
    print("Bill: " + str(base) + " + GST " + str(gst) + " = Rs. " + str(total))


def cancel_booking():
    try:
        room = int(input("Room number to cancel: "))
    except ValueError:
        print("Invalid room number.")
        return
    for b in bookings:
        if b["room"] == room:
            bookings.remove(b)
            save_bookings()
            print("Booking for room " + str(room) + " cancelled. Room " + str(room) + " is now available.")
            return
    print("No booking found for room " + str(room) + ".")


def generate_bill():
    try:
        room = int(input("Room number: "))
    except ValueError:
        print("Invalid room number.")
        return
    for b in bookings:
        if b["room"] == room:
            base, gst, total = calculate_bill(room, b["nights"])
            print("Guest: " + b["guest"] + " | Room " + str(room) + " | " + str(b["nights"]) + " night(s)")
            print("Bill: " + str(base) + " + GST " + str(gst) + " = Rs. " + str(total))
            return
    print("No booking found for room " + str(room) + ".")


def main():
    load_bookings()
    while True:
        print("\n--- Hotel Room Booking System ---")
        print("1. View available rooms")
        print("2. Book a room")
        print("3. Generate bill")
        print("4. Cancel booking")
        print("5. Exit")
        choice = input("Menu option: ").strip()

        if choice == "1":
            view_available()
        elif choice == "2":
            book_room()
        elif choice == "3":
            generate_bill()
        elif choice == "4":
            cancel_booking()
        elif choice == "5":
            print("Thank you!")
            break
        else:
            print("Invalid option. Try again.")


main()
